  --node aws-linux-node-b --bind 127.0.0.1:9235 --token node-secret-b
  PORT_DEMO_TOKEN=demo-token port --config examples/port.toml service secret put
  --machine cloud-aws --name demo-token --value s3cr3t
  PORT_DEMO_TOKEN=demo-token port --config examples/port.toml service apply
  --machine cloud-aws --host-group aws-secondary --name api --kind service
  --secret API_TOKEN=demo-token -- /bin/sh -lc 'trap '''exit 0''' TERM; while :;
  do sleep 1; done'
