[clusters.demo]
# First cluster contract:
#   this is the single-node local K3s lane. Hosted, AWS, and multi-node
#   expansion stay explicit follow-on work until Port owns the wider lifecycle.
flavor = "k3s"
provider = "local"
count = 1
machine = "demo"
version = "v1.32.2+k3s1"
args = ["--disable=traefik"]

[clusters.demo.bootstrap]
# Repo-local offline bootstrap kit for the first cluster slice. This fixture
# keeps the install path Port-owned and live-fetch-free until a fully packaged
# K3s artifact lane lands.
stage_root = "/opt/port/clusters/demo"
install_script = "examples/bootstrap/demo-k3s/install-k3s-offline.sh"
binary = "examples/bootstrap/demo-k3s/k3s"

[clusters.demo.bootstrap.guest_profile]
name = "kube-ready"
required_commands = ["sh", "install", "ln", "chmod", "dirname", "setsid"]

[clusters.demo.lifecycle]
health_command = [
  "opt/port/clusters/demo/bin/k3s",
  "kubectl",
  "get",
  "nodes",
  "-o",
  "wide",
]
kubeconfig_path = "/etc/rancher/k3s/k3s.yaml"
api_forward_target = "127.0.0.1:6443"

