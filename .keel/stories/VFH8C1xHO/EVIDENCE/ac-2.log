state = "planned"
notes = ["Generic Linux is modeled as PVM-planned but not host-kit-ready in the sample inventory."]

[nodes.aws-linux-node]
# Hosted PVM admission-ready example:
#   switching [machines.cloud-aws] to protection_mode = "pvm" should pass the
#   hosted placement gate because this node advertises a ready PVM lane and can
#   launch once the host kit and PVM artifact paths are prepared.
# Hosted Cloud Hypervisor proof:
#   keep the checked-in sample on the Firecracker standard lane, then copy this
#   config and switch [machines.cloud-aws].substrate to "cloud-hypervisor",
#   [machines.cloud-aws].architecture to "x86_64", and
#   [nodes.aws-linux-node.capabilities].substrates to ["cloud-hypervisor"] when
#   you want the hosted Cloud Hypervisor workflow. Leaving this node on
#   ["firecracker"] is the explicit rejected-node proof for that lane.
host = "aws-linux"
runtime_root = "runtime/hosted/aws-linux-node"
notes = ["AWS stays explicit because later host-group and PVM planning will care about provider identity."]

[nodes.aws-linux-node.capabilities]
