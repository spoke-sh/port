notes = [
  "The host kernel must carry the Firecracker/PVM-capable KVM changes rather than stock KVM alone.",
  "The VMM binary must be a PVM-capable Firecracker build, not the current standard lane binary.",
]

[nodes.gcp-linux-node]
host = "gcp-linux"
runtime_root = "runtime/hosted/gcp-linux-node"
notes = ["GCP is modeled as a hosted node so placement and lifecycle work can remain provider-aware."]

[nodes.gcp-linux-node.capabilities]
providers = ["gcp"]
platforms = ["linux"]
substrates = ["firecracker"]
architectures = ["x86_64"]
protection_modes = ["standard", "pvm"]

[[nodes.gcp-linux-node.capabilities.pvm_lanes]]
architecture = "x86_64"
state = "planned"
notes = ["GCP remains modeled as a planned PVM node until a prepared host kit is explicitly advertised."]

[host_groups.remote-linux]
placement = "explicit-membership"
scheduler = "deterministic-first-fit"
nodes = ["generic-linux-node", "aws-linux-node", "gcp-linux-node"]
notes = ["This group is the first hosted placement boundary; later scheduler, monitoring, and services work should reuse it instead of inventing another inventory axis."]

[host_groups.aws-builders]
placement = "explicit-membership"
scheduler = "deterministic-first-fit"
nodes = ["aws-linux-node"]
notes = ["Provider-specific groups stay explicit so later scheduling and service placement can target them without creating a second host taxonomy."]

[machines.demo]
# Standard shipped lane:
#   keep this machine on protection_mode = "standard" when you want the real
#   local Firecracker launch proof while PVM remains a gated admission lane.
host = "local"
kernel = "demo-kernel"
guest_image = "demo-guest"
substrate = "firecracker"
protection_mode = "standard"
architecture = "native"
vcpu_count = 2
memory_mib = 512
kernel_args = "console=ttyS0 reboot=k panic=1 pci=off root=/dev/vda rw"
rootfs_read_only = false

[machines.demo.guest]
vsock_cid = 52
control_port = 7000
console_log = "runtime/demo/console.log"

