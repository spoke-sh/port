#!/bin/sh
set -eu

store_path="${PORT_K3S_STORE_PATH:-}"
if [ -z "${store_path}" ] && [ -f /etc/port-k3s-store-path ]; then
  store_path="$(cat /etc/port-k3s-store-path)"
fi

if [ -z "${store_path}" ]; then
  echo "missing Port K3s store path; set PORT_K3S_STORE_PATH or provide /etc/port-k3s-store-path" >&2
  exit 1
fi

exec "${store_path}/bin/k3s" "$@"
